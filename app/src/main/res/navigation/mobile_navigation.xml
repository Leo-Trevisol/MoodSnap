<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.br.leo.moodsnap.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_dashboard"
            app:destination="@id/navigation_dashboard"
            app:enterAnim="@anim/dialog_enter"
            app:exitAnim="@anim/dialog_exit"
            app:popEnterAnim="@anim/dialog_enter"
            app:popExitAnim="@anim/dialog_exit" />
    </fragment>

    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.br.leo.moodsnap.ui.dashboard.DashboardFragment"
        android:label="@string/title_dashboard"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_dashboard_to_home"
            app:destination="@id/navigation_home"
            app:enterAnim="@anim/dialog_enter"
            app:exitAnim="@anim/dialog_exit"
            app:popEnterAnim="@anim/dialog_enter"
            app:popExitAnim="@anim/dialog_exit" />
    </fragment>

</navigation>