<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp">

    <ImageView
        android:id="@+id/btn_close_dialog"
        android:layout_width="@dimen/options_icons_size"
        android:layout_height="@dimen/options_icons_size"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:src="@drawable/ic_xmark"
        android:contentDescription="@string/btn_back"
        android:layout_marginStart="@dimen/spacing_normal"
        app:tint="@color/secundary" />

    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="20sp"
        android:textColor="@color/secundary"
        android:textAlignment="center"
        android:text="@string/hint_date" />

    <!-- Espaço vazio para equilibrar o layout -->
    <View
        android:layout_width="@dimen/options_icons_size"
        android:layout_height="@dimen/options_icons_size"
        android:layout_marginEnd="@dimen/spacing_normal"
        />

</LinearLayout>
