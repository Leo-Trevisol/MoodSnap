<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="@dimen/calendar_grid_padding">

    <androidx.cardview.widget.CardView
        android:id="@+id/day_card"
        android:layout_width="@dimen/item_calendar_day"
        android:layout_height="@dimen/item_calendar_day"
        android:layout_gravity="center"
        app:cardCornerRadius="@dimen/calendar_day_corner_radius"
        app:cardElevation="0dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/mood_indicator"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:visibility="visible"
            tools:src="@drawable/happy_icon"/>

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/day_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_small"
        android:layout_marginTop="@dimen/spacing_small"
        android:textAlignment="center"
        tools:text="15"/>

</LinearLayout> 