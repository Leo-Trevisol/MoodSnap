<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <TextView
        android:id="@+id/share_preview_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/share_preview_title"
        android:textSize="@dimen/text_size_xlarge"
        android:textStyle="bold"
        android:textColor="@color/secundary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/share_preview_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/share_preview_description"
        android:scaleType="fitCenter"
        app:layout_constraintDimensionRatio="H,1200:630"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/share_preview_title"
        app:shapeAppearanceOverlay="@style/RoundedImageView" />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_share_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/btn_share"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:cornerRadius="8dp"
        app:layout_constraintTop_toBottomOf="@id/share_preview_image" />

</androidx.constraintlayout.widget.ConstraintLayout>
