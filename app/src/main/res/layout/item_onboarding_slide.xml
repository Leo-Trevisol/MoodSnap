<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/spacing_large">

    <ImageView
        android:id="@+id/imageSlide"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="@dimen/spacing_large"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="@string/tutorial_image"/>

    <TextView
        android:id="@+id/titleSlide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/secundary"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/imageSlide"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_normal"
        android:layout_marginBottom="@dimen/spacing_normal"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/titleSlide"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/descriptionSlide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:gravity="center"
            android:textColor="@color/secundary"
            android:lineSpacingExtra="4dp"/>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout> 