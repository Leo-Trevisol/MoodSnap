<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/login_bottom_sheet_root" 
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/background_rounded_top"
    android:padding="@dimen/spacing_large">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/spacing_large"
        android:background="@color/secundary" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_large">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="@dimen/options_icons_size"
            android:layout_height="@dimen/options_icons_size"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/btn_back"
            app:tint="@color/secundary" />

        <TextView
            android:id="@+id/text_font_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/user_profile_title"
            android:textColor="@color/secundary"
            android:textSize="@dimen/text_size_xlarge"
            android:textStyle="bold"
            android:gravity="center" />

    </RelativeLayout>

    
    <LinearLayout
        android:id="@+id/layout_logged_out_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="0dp" 
        android:paddingEnd="0dp"   
        android:visibility="visible">

        <ImageView
            android:id="@+id/image_logo_login"
            android:layout_width="100dp" 
            android:layout_height="100dp" 
            android:src="@drawable/ic_mascote"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/text_login_benefit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_benefit_text"
            android:textSize="16sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center_horizontal"
            android:layout_marginBottom="28dp"
            android:paddingStart="16dp" 
            android:paddingEnd="16dp"/>

        <com.google.android.gms.common.SignInButton
            android:id="@+id/btn_google_sign_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"/> 
    </LinearLayout>


    <LinearLayout
        android:id="@+id/layout_logged_in_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="8dp">

        <!-- CARD DE PERFIL -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <!-- AVATAR -->
                <ImageView
                    android:id="@+id/image_user_avatar"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_user"
                    android:background="@drawable/bg_circle_surface"
                    android:scaleType="centerCrop"
                    android:layout_marginBottom="12dp" />

                <!-- NOME -->
                <TextView
                    android:id="@+id/text_user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Nome do Usuário"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="4dp" />

                <!-- EMAIL -->
                <TextView
                    android:id="@+id/text_user_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="usuario@exemplo.com"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="16dp" />

                <!-- DIVISOR -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorOutline"
                    android:layout_marginBottom="16dp"/>

                <!-- UID LABEL -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/user_id_label"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"/>

                <!-- UID -->
                <TextView
                    android:id="@+id/text_user_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="abcdef1234567890"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="8dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BOTÃO LOGOUT -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sign_out"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sign_out_button"
            android:icon="@drawable/ic_xmark"
            android:paddingVertical="14dp"
            app:cornerRadius="16dp"
            app:backgroundTint="?attr/colorSurface"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutline"
            android:textColor="?attr/colorOnSurface"
            style="?attr/materialButtonOutlinedStyle"/>

    </LinearLayout>

</LinearLayout>
