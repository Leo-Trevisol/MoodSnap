<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/linear_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_large"
            android:visibility="gone"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageView_iconDialog"
                android:layout_width="@dimen/options_icons_size"
                android:layout_height="@dimen/options_icons_size"
                app:tint="@color/secundary"/>

            <TextView
                android:id="@+id/textView_titleDialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/spacing_normal"
                android:text="Atenção"
                android:textColor="@color/day_text_color"
                android:textSize="@dimen/text_size_xlarge"
                android:textStyle="bold"/>
        </LinearLayout>

        <View
            android:id="@+id/view_margin"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="@dimen/spacing_normal">

        </View>

        <TextView
            android:id="@+id/textView_customDialogMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_large"
            android:text="Deseja voltar para o menu principal?"
            android:textColor="@color/day_text_color"
            android:gravity="center"
            android:textSize="@dimen/text_size_large" />

        <LinearLayout
            android:id="@+id/buttons_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginHorizontal="@dimen/spacing_large"
            android:layout_marginTop="@dimen/spacing_large">

            <Button
                android:id="@+id/btn_cancel"
                style="@style/RoundedConfirmButton"
                android:text="@string/btn_cancel"
                android:layout_marginEnd="@dimen/spacing_normal"
                />

            <Button
                android:id="@+id/btn_confirm"
                style="@style/RoundedConfirmButton"
                android:text="@string/btn_confirm"
                android:layout_marginStart="@dimen/spacing_normal"
                />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>