<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_large">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/font_settings"
        android:textSize="@dimen/text_size_large"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="@dimen/spacing_large"/>

    <Button
        android:id="@+id/btn_default_font"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_rounded"
        android:text="@string/default_font"
        android:textStyle="bold"
        android:shadowColor="@color/white"
        android:layout_marginBottom="@dimen/spacing_normal"
        android:textSize="@dimen/button_text_size"
        android:padding="16dp"/>

    <Button
        android:id="@+id/btn_roboto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_rounded"
        android:text="@string/roboto_font"
        android:textStyle="bold"
        android:shadowColor="@color/white"
        android:layout_marginBottom="@dimen/spacing_normal"
        android:textSize="@dimen/button_text_size"
        android:padding="16dp"/>

    <Button
        android:id="@+id/btn_open_sans"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_rounded"
        android:text="@string/open_sans_font"
        android:textStyle="bold"
        android:shadowColor="@color/white"
        android:layout_marginBottom="@dimen/spacing_normal"
        android:textSize="@dimen/button_text_size"
        android:padding="16dp"/>

    <Button
        android:id="@+id/btn_lato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_rounded"
        android:text="@string/lato_font"
        android:textStyle="bold"
        android:shadowColor="@color/white"
        android:layout_marginBottom="@dimen/spacing_normal"
        android:textSize="@dimen/button_text_size"
        android:padding="16dp"/>

    <Button
        android:id="@+id/btn_poppins"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_rounded"
        android:text="@string/poppins_font"
        android:textStyle="bold"
        android:shadowColor="@color/white"
        android:layout_marginBottom="@dimen/spacing_normal"
        android:textSize="@dimen/button_text_size"
        android:padding="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:background="@android:color/transparent"
            android:textColor="@color/primary_green"
            android:text="@string/btn_back" />

        <Button
            android:id="@+id/btn_confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:background="@drawable/rounded_button_shadow_green"
            android:textColor="@color/primary_green"
            android:text="@string/btn_confirm"/>
    </LinearLayout>

</LinearLayout> 