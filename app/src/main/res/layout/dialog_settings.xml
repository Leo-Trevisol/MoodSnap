<?xml version="1.0" encoding="utf-8"?>
<LinearLayout  xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_large">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <TextView
        android:id="@+id/text_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/select_settings_option"
        android:textColor="@color/secundary"
        android:textSize="@dimen/text_size_xlarge"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="@dimen/spacing_large"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

        <ScrollView
            android:id="@+id/linear_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_settings"
            app:layout_constraintBottom_toTopOf="@+id/linear_final_buttons"
            >

        <LinearLayout
            android:id="@+id/settings_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/spacing_large"
            android:paddingStart="@dimen/spacing_large"
            android:paddingEnd="@dimen/spacing_large"
            >

            <Button
                android:id="@+id/btn_languages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_normal"
                android:background="@drawable/background_rounded"
                android:backgroundTint="@color/white"
                android:drawableEnd="@drawable/ic_language"
                android:drawableTint="@color/primary"
                android:padding="16dp"
                android:text="@string/languages"
                android:textSize="@dimen/button_size"/>

            <Button
                android:id="@+id/btn_themes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_normal"
                android:background="@drawable/background_rounded"
                android:backgroundTint="@color/white"
                android:drawableEnd="@drawable/ic_theme"
                android:drawableTint="@color/primary"
                android:padding="16dp"
                android:text="@string/themes"
                android:textSize="@dimen/button_size"/>

            <Button
                android:id="@+id/btn_notifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_normal"
                android:background="@drawable/background_rounded"
                android:backgroundTint="@color/white"
                android:drawableEnd="@drawable/ic_bell"
                android:drawableTint="@color/primary"
                android:padding="16dp"
                android:text="@string/notifications"
                android:textSize="@dimen/button_size"/>

            <Button
                android:id="@+id/btn_fonts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_normal"
                android:background="@drawable/background_rounded"
                android:backgroundTint="@color/white"
                android:drawableEnd="@drawable/ic_font"
                android:drawableTint="@color/primary"
                android:padding="16dp"
                android:text="@string/font"
                android:textSize="@dimen/button_size"/>

            <Button
                android:id="@+id/btn_tutorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_normal"
                android:background="@drawable/background_rounded"
                android:backgroundTint="@color/white"
                android:drawableEnd="@drawable/ic_tutorial"
                android:drawableTint="@color/primary"
                android:padding="16dp"
                android:text="@string/tutorial"
                android:textSize="@dimen/button_size"/>

        </LinearLayout>

        </ScrollView>


        <LinearLayout
            android:id="@+id/linear_final_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingStart="@dimen/spacing_large"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linear_settings"
            app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/button_confirm_cancel"
            android:background="@android:color/transparent"
            android:textColor="@color/primary_green"
            android:text="@string/btn_back"/>
    </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout> 