<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema Alternativo (totalmente preto) -->
    <style name="Theme.MoodSnap.Main" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/primary_background</item>
        <item name="android:statusBarColor">@color/dark_secondary_variant</item>
        <item name="android:navigationBarColor">@color/dark_primary</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="behavior_peekHeight">0dp</item>
        <item name="behavior_hideable">true</item>
    </style>

</resources>
