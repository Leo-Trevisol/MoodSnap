<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Estilo personalizado para a Action Bar -->
    <style name="CustomActionBar" parent="Widget.AppCompat.ActionBar">
        <item name="android:background">@drawable/gradient_background</item> <!-- Cor de fundo da ActionBar -->
        <item name="android:titleTextStyle">@style/ActionBarTitle</item> <!-- Estilo do título -->
    </style>

    <!-- Estilo do título da Action Bar -->
    <style name="ActionBarTitle">
        <item name="android:textColor">@color/dark_primary</item> <!-- Cor do texto do título -->
    </style>

    <!-- Tema para a tela de splash -->
    <style name="SplashTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Cor de fundo da tela inicial -->
        <item name="android:windowBackground">@drawable/gradient_background</item>
    </style>

    <style name="Nav" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:navigationBarColor">@android:color/white</item>
    </style>

    <style name="RoundedDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/background_rounded</item>
    </style>

    <style name="CustomAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="materialAlertDialogTitleTextStyle">@style/CustomTitleTextStyle</item>
        <item name="buttonBarPositiveButtonStyle">@style/CustomButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/CustomButtonStyle</item>
        <item name="materialAlertDialogTitlePanelStyle">@style/CustomTitlePanelStyle</item>
        <item name="buttonBarStyle">@style/CustomButtonBarStyle</item>
        <item name="android:background">@color/dark_secondary_variant</item>
        <item name="android:windowBackground">@color/dark_secondary_variant</item>
    </style>

    <style name="CustomTitleTextStyle" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textSize">20sp</item>
        <item name="android:textAlignment">center</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="CustomTitlePanelStyle" parent="MaterialAlertDialog.MaterialComponents.Title.Panel">
        <item name="android:padding">16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:paddingTop">8dp</item>
    </style>

    <style name="CustomButtonBarStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="CustomButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textSize">16sp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:minWidth">120dp</item>
        <item name="android:textColor">@color/primary_green</item>
    </style>

    <style name="CustomNumberPicker">
        <item name="android:textSize">16sp</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="colorControlNormal">@color/primary_green</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="DialogRounded" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/background_rounded_60_white</item>
    </style>
</resources>
