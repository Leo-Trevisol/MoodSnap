<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema Principal Escuro -->
    <style name="Theme.MoodSnap" parent="Theme.Material3.Light.NoActionBar">
        <!-- Cores principais escuras -->
        <item name="colorPrimary">@color/dark_primary</item>
        <item name="colorPrimaryVariant">@color/dark_primary_variant</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/dark_secondary</item>
        <item name="colorSecondaryVariant">@color/dark_secondary_variant</item>
        <item name="colorOnSecondary">@color/dark_primary</item>

        <!-- Cor de fundo e status bar -->
        <item name="android:windowBackground">@drawable/gradient_background</item>
        <item name="android:statusBarColor">@color/dark_primary_variant</item>
        <item name="android:navigationBarColor">@color/dark_background</item>

        <!-- Remove ActionBar -->
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
    </style>

    <!-- Tema Alternativo (totalmente preto) -->
    <style name="Theme.MoodSnap.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="android:statusBarColor">@color/dark_secondary_variant</item>
        <item name="android:navigationBarColor">@color/dark_primary</item>
        <item name="android:fontFamily">@font/mulish_regular</item>
    </style>

</resources>
